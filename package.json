{
  "name": "bugger",
  "private": true,
  "scripts": {
    "dev:extension": "pnpm --filter @bugger/extension dev",
    "dev:app": "pnpm --filter @bugger/app dev",
    "build": "pnpm build:extension && pnpm pack:extension && pnpm --filter @bugger/app build",
    "build:extension": "pnpm --filter @bugger/extension build",
    "pack:extension": "bash scripts/pack-extension.sh",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
